<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css"></head><body>
<nav class="navbar navbar-dark app-nav px-3"><a class="navbar-brand fw-bold" href="/">UTUNYANGE</a><div class="text-white"><%= user.name %> &middot; Administrator <form class="d-inline" method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-light ms-2">Logout</button></form></div></nav>
<main class="container-fluid px-3 px-lg-4 py-4"><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><p class="eyebrow mb-1">SCHOOL MANAGEMENT</p><h1 class="h3 mb-1">Administrator dashboard</h1><p class="text-secondary mb-0">Manage accounts, classes, subjects and teacher-parent relationships.</p></div></div>
<% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row g-3 mb-4">
<% const cards=[["Students",stats.student||0],["Teachers",stats.teacher||0],["Parents",stats.parent||0],["Staff",stats.staff||0],["Classes",stats.classes||0],["Subjects",stats.subjects||0]]; cards.forEach(c=>{ %>
<div class="col-6 col-md-4 col-xl-2"><div class="stat-card"><div class="stat-label"><%= c[0] %></div><div class="stat-number"><%= c[1] %></div></div></div><% }) %>
</div>
<div class="row g-4">
<div class="col-xl-5"><section class="panel"><h2 class="h5">Create user account</h2><form method="post" action="/dashboard/admin/users" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" name="full_name" required maxlength="160"></div>
<div class="col-md-6"><label class="form-label">Role</label><select class="form-select" name="role" id="newRole" required><option value="">Choose role</option><option>student</option><option>teacher</option><option>parent</option><option>staff</option><option value="dos">Director of Studies</option><option value="accountant">Accountant / Bursar</option><option value="head_teacher">Head Teacher / Master</option><option value="deputy_head">Deputy Head Teacher</option><option value="librarian">Librarian</option><option value="secretary">School Secretary</option><option>admin</option></select></div>
<div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required></div>
<div class="col-md-6"><label class="form-label">Username (optional)</label><input class="form-control" name="username"></div>
<div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" name="phone"></div>
<div class="col-md-6" id="admissionField"><label class="form-label">Admission number (students)</label><input class="form-control" name="admission_number"></div>
<div class="col-md-6" id="employeeField"><label class="form-label">Employee number (teachers)</label><input class="form-control" name="employee_number"></div>
<div class="col-md-6" id="qualificationField"><label class="form-label">Qualification</label><input class="form-control" name="qualification"></div>
<div class="col-12"><label class="form-label">Temporary password (minimum 12 characters)</label><input class="form-control" type="password" name="password" minlength="12" required autocomplete="new-password"></div>
<div class="col-12"><button class="btn btn-primary">Create account</button></div></form></section></div>
<div class="col-xl-7"><section class="panel"><h2 class="h5">User accounts</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Status</th></tr></thead><tbody>
<% users.forEach(u=>{ %><tr><td><strong><%= u.full_name %></strong><small class="d-block text-secondary"><%= u.username %></small></td><td><span class="role-pill <%= u.role %>"><%= u.role %></span></td><td><%= u.email %></td><td><span class="status-dot <%= u.status %>"></span><%= u.status %></td></tr><% }) %>
<% if(!users.length){ %><tr><td colspan="4" class="text-secondary">No user accounts found.</td></tr><% } %></tbody></table></div><p class="small text-secondary mb-0">Showing the 100 most recently created accounts. Account editing and deactivation will be added in the next iteration.</p></section></div>
<div class="col-lg-4"><section class="panel"><h2 class="h5">Add class</h2><form method="post" action="/dashboard/admin/classes" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Class name</label><input class="form-control" name="class_name" required placeholder="e.g. Senior 1 A"><label class="form-label">Level</label><input class="form-control" name="level" placeholder="e.g. Senior 1"><label class="form-label">Academic year</label><input class="form-control" name="academic_year" placeholder="e.g. 2026"><button class="btn btn-outline-primary mt-2">Save class</button></form></section></div>
<div class="col-lg-4"><section class="panel"><h2 class="h5">Add subject</h2><form method="post" action="/dashboard/admin/subjects" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Subject name</label><input class="form-control" name="subject_name" required placeholder="e.g. Mathematics"><label class="form-label">Subject code</label><input class="form-control" name="subject_code" placeholder="e.g. MATH"><button class="btn btn-outline-primary mt-2">Save subject</button></form></section></div>
<div class="col-lg-4"><section class="panel"><h2 class="h5">Assign teacher</h2><form method="post" action="/dashboard/admin/assign-teacher" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Teacher</label><select class="form-select" name="teacher_id" required><option value="">Choose teacher</option><% lists.teachersList.forEach(t=>{ %><option value="<%= t.id %>"><%= t.full_name %></option><% }) %></select><label class="form-label">Class</label><select class="form-select" name="class_id" required><option value="">Choose class</option><% lists.classes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.class_name %></option><% }) %></select><label class="form-label">Subject</label><select class="form-select" name="subject_id" required><option value="">Choose subject</option><% lists.subjects.forEach(s=>{ %><option value="<%= s.id %>"><%= s.subject_name %></option><% }) %></select><button class="btn btn-outline-primary mt-2">Save assignment</button></form></section></div>
<div class="col-lg-6"><section class="panel"><h2 class="h5">Place student in class</h2><form method="post" action="/dashboard/admin/assign-student-class" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-6"><label class="form-label">Student</label><select class="form-select" name="student_id" required><option value="">Choose student</option><% lists.studentsList.forEach(s=>{ %><option value="<%= s.id %>"><%= s.full_name %> â€” <%= s.admission_number %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Class</label><select class="form-select" name="class_id" required><option value="">Choose class</option><% lists.classes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.class_name %></option><% }) %></select></div><div class="col-12"><button class="btn btn-outline-primary">Save placement</button></div></form></section></div>
<div class="col-lg-6"><section class="panel"><h2 class="h5">Link parent to student</h2><form method="post" action="/dashboard/admin/link-parent" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-6"><label class="form-label">Parent</label><select class="form-select" name="parent_id" required><option value="">Choose parent</option><% lists.parents.forEach(p=>{ %><option value="<%= p.id %>"><%= p.full_name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Student</label><select class="form-select" name="student_id" required><option value="">Choose student</option><% lists.studentsList.forEach(s=>{ %><option value="<%= s.id %>"><%= s.full_name %> â€” <%= s.admission_number %></option><% }) %></select></div><div class="col-md-8"><label class="form-label">Relationship</label><input class="form-control" name="relationship" value="Parent"></div><div class="col-12"><button class="btn btn-outline-primary">Link parent</button></div></form></section></div>
</div></main>
<script>
const role=document.getElementById('newRole');
function toggleRoleFields(){document.getElementById('admissionField').hidden=role.value!=='student';document.getElementById('employeeField').hidden=role.value!=='teacher';document.getElementById('qualificationField').hidden=role.value!=='teacher';}
role.addEventListener('change',toggleRoleFields);toggleRoleFields();
</script></body></html>
