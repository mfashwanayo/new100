<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/dashboards.css"></head><body>
<nav class="navbar navbar-dark app-nav px-3"><a class="navbar-brand fw-bold" href="/dashboard/admin">UTUNYANGE Â· Admin</a><a class="btn btn-sm btn-outline-light" href="/dashboard/admin">Back to dashboard</a></nav>
<main class="container py-4"><p class="eyebrow">ACADEMIC OPERATIONS</p><h1 class="h3">Timetable & announcements</h1><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>
<div class="row g-4"><div class="col-lg-6"><section class="panel"><h2 class="h5">Publish announcement</h2><form method="post" action="/dashboard/admin/announcements" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Title</label><input class="form-control" name="title" required maxlength="180"><label class="form-label">Message</label><textarea class="form-control" name="body" rows="5" required></textarea><label class="form-label">Audience</label><select class="form-select" name="audience"><option value="all">Everyone</option><option value="student">Students</option><option value="parent">Parents</option><option value="teacher">Teachers</option><option value="staff">Staff</option></select><button class="btn btn-primary mt-2">Publish announcement</button></form></section></div>
<div class="col-lg-6"><section class="panel"><h2 class="h5">Add timetable entry</h2><form method="post" action="/dashboard/admin/timetable" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Class</label><select class="form-select" name="class_id" required><option value="">Choose class</option><% classes.forEach(x=>{ %><option value="<%= x.id %>"><%= x.class_name %></option><% }) %></select><label class="form-label">Subject</label><select class="form-select" name="subject_id" required><option value="">Choose subject</option><% subjects.forEach(x=>{ %><option value="<%= x.id %>"><%= x.subject_name %></option><% }) %></select><label class="form-label">Teacher</label><select class="form-select" name="teacher_id" required><option value="">Choose teacher</option><% teachers.forEach(x=>{ %><option value="<%= x.id %>"><%= x.full_name %></option><% }) %></select><label class="form-label">Day</label><select class="form-select" name="day_of_week"><% ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"].forEach(x=>{ %><option><%= x %></option><% }) %></select><div class="row"><div class="col"><label class="form-label">Start</label><input class="form-control" type="time" name="start_time" required></div><div class="col"><label class="form-label">End</label><input class="form-control" type="time" name="end_time" required></div></div><label class="form-label">Room</label><input class="form-control" name="room"><button class="btn btn-primary mt-2">Save timetable entry</button></form></section></div>
<div class="col-lg-6"><section class="panel"><h2 class="h5">Add book / material</h2><form method="post" action="/dashboard/admin/books" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Title</label><input class="form-control" name="title" required maxlength="200" placeholder="e.g. Mathematics Grade 8"><div class="row"><div class="col"><label class="form-label">Author</label><input class="form-control" name="author" maxlength="160"></div><div class="col"><label class="form-label">Subject</label><select class="form-select" name="subject_id"><option value="">General</option><% subjects.forEach(x=>{ %><option value="<%= x.id %>"><%= x.subject_name %></option><% }) %></select></div></div><label class="form-label">Class (optional)</label><select class="form-select" name="class_id"><option value="">All classes</option><% classes.forEach(x=>{ %><option value="<%= x.id %>"><%= x.class_name %></option><% }) %></select><label class="form-label">Description</label><textarea class="form-control" name="description" rows="2"></textarea><label class="form-label">Cover image URL (optional)</label><input class="form-control" name="cover_url" placeholder="https://..."><label class="form-label">File path / URL (optional)</label><input class="form-control" name="file_path" placeholder="/uploads/book.pdf or https://..."><button class="btn btn-primary mt-2">Add book</button></form></section></div></div></main></body></html>
