<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white flex-wrap">
    <span class="nav-role-tag"><%= roleLabel %></span>
    <%= user.name %>
    <a href="/dashboard/<%= user.role %>/chat" class="btn btn-sm btn-outline-light">
      <i class="bi bi-chat-dots"></i> Chat
      <% if(unreadChat>0){ %><span class="badge bg-warning text-dark"><%= unreadChat %></span><% } %>
    </a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container py-4">
  <div class="page-header">
    <p class="eyebrow">STAFF WORKSPACE</p>
    <h1>Welcome, <%= user.name %></h1>
    <p><%= roleLabel %> portal &middot; UTUNYANGE School</p>
  </div>

  <% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat-card yellow"><div class="stat-label">Role</div><div class="h4 mt-2"><%= roleLabel %></div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card green"><div class="stat-label">Unread messages</div><div class="stat-number"><%= unreadChat %></div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card purple"><div class="stat-label">Announcements</div><div class="stat-number"><%= announcements.length %></div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-label">Notifications</div><div class="stat-number"><%= notifications.length %></div></div></div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <section class="panel">
        <h2 class="h5">School announcements</h2>
        <% if(!announcements.length){ %><p class="text-secondary">No announcements.</p><% } %>
        <% announcements.forEach(a=>{ %>
          <article class="announcement">
            <strong><%= a.title %></strong>
            <p><%= a.body %></p>
            <small><%= a.published_at %></small>
          </article>
        <% }) %>
      </section>
    </div>
    <div class="col-lg-5">
      <section class="panel">
        <h2 class="h5">Notifications</h2>
        <% if(!notifications.length){ %><p class="text-secondary">No notifications.</p><% } %>
        <% notifications.forEach(n=>{ %>
          <div class="notification-item">
            <span class="notification-dot"></span>
            <div><p class="fw-bold mb-0"><%= n.title %></p><p class="mb-0"><%= n.message %></p><small><%= n.created_at %></small></div>
          </div>
        <% }) %>
      </section>
      <section class="panel mt-4">
        <h2 class="h5">Quick actions</h2>
        <div class="quick-actions">
          <a href="/dashboard/<%= user.role %>/chat" class="quick-action-btn"><i class="bi bi-chat-dots"></i> Open chat</a>
        </div>
        <p class="text-secondary small mb-0">Your account is authenticated. Operational tools for your role will be added in upcoming modules.</p>
      </section>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>