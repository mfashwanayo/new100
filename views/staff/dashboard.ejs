<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <span class="nav-role-tag">Staff</span>
    <%= user.name %>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container py-4">
  <div class="page-header">
    <p class="eyebrow">STAFF WORKSPACE</p>
    <h1>Welcome, <%= user.name %></h1>
    <p>Your staff portal. Additional tools will be available in future stages.</p>
  </div>

  <div class="row g-4">
    <div class="col-md-6 col-xl-3">
      <div class="stat-card yellow">
        <div class="stat-label">My profile</div>
        <div class="mt-3 text-muted" style="font-size:.9rem">Staff information</div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="stat-card">
        <div class="stat-label">Work schedule</div>
        <div class="mt-3 text-muted" style="font-size:.9rem">Assigned schedule</div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="stat-card green">
        <div class="stat-label">Notices</div>
        <div class="mt-3 text-muted" style="font-size:.9rem">School announcements</div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="stat-card purple">
        <div class="stat-label">Support</div>
        <div class="mt-3 text-muted" style="font-size:.9rem">Administration support</div>
      </div>
    </div>

    <div class="col-12">
      <div class="alert alert-info">
        <strong>Dashboard foundation</strong> &mdash; Your account is authenticated. Operational tools, school records and reports will be added in upcoming modules.
      </div>
    </div>
  </div>
</main>
</body>
</html>
