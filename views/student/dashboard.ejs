<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <%= user.name %> &middot; Student
    <a href="/dashboard/student/lms" class="btn btn-sm btn-outline-light">Lessons &amp; Assignments</a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>
<main class="container py-4">
<p class="eyebrow mb-1">MY LEARNING SPACE</p>
<h1 class="h3">Welcome, <%= profile.full_name %></h1>
<div class="row g-3 my-2">
<div class="col-md-4"><div class="stat-card"><div class="stat-label">Admission number</div><div class="h4 mt-2"><%= profile.admission_number %></div></div></div>
<div class="col-md-4"><div class="stat-card"><div class="stat-label">Class</div><div class="h4 mt-2"><%= profile.class_name||"Not assigned" %></div></div></div>
<div class="col-md-4"><div class="stat-card"><div class="stat-label">Academic year</div><div class="h4 mt-2"><%= profile.academic_year||"&mdash;" %></div></div></div>
</div>
<div class="row g-4">
<div class="col-lg-7"><section class="panel"><h2 class="h5">My timetable</h2><div class="table-responsive"><table class="table"><thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Teacher</th><th>Room</th></tr></thead><tbody>
<% timetable.forEach(t=>{ %><tr><td><%= t.day_of_week %></td><td><%= String(t.start_time).slice(0,5) %>&ndash;<%= String(t.end_time).slice(0,5) %></td><td><%= t.subject_name %></td><td><%= t.teacher_name %></td><td><%= t.room||"&mdash;" %></td></tr><% }) %>
<% if(!timetable.length){ %><tr><td colspan="5">Timetable not published yet.</td></tr><% } %>
</tbody></table></div></section></div>

<div class="col-lg-5"><section class="panel"><h2 class="h5">Attendance history</h2><table class="table"><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody>
<% attendance.forEach(a=>{ %><tr><td><%= a.attendance_date %></td><td><span class="badge <%= a.status==='present'?'bg-success':a.status==='absent'?'bg-danger':a.status==='late'?'bg-warning text-dark':'bg-secondary' %>"><%= a.status %></span></td></tr><% }) %>
<% if(!attendance.length){ %><tr><td colspan="2">No attendance recorded.</td></tr><% } %>
</tbody></table></section></div>

<div class="col-lg-7"><section class="panel"><h2 class="h5">Published examination results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Assessment</th><th>Subject</th><th>Marks</th><th>Percent</th></tr></thead><tbody>
<% results.forEach(x=>{let p=Number(x.total_marks)?Number(x.marks_obtained)/Number(x.total_marks)*100:0;%>
<tr><td><%= x.title %></td><td><%= x.subject_name %></td><td><%= x.marks_obtained %>/<%= x.total_marks %></td><td><%= p.toFixed(1) %>%</td></tr><% }) %>
<% if(!results.length){ %><tr><td colspan="4">No published results.</td></tr><% } %>
</tbody></table></div></section></div>

<div class="col-lg-5"><section class="panel"><h2 class="h5">School announcements</h2>
<% announcements.forEach(a=>{ %><article class="mb-3"><strong><%= a.title %></strong><p class="mb-1 text-secondary"><%= a.body %></p><small class="text-secondary"><%= a.published_at %></small></article><% }) %>
<% if(!announcements.length){ %><p class="text-secondary">No announcements.</p><% } %>
</section></div>

<div class="col-12"><section class="panel"><h2 class="h5">Notifications</h2>
<% notifications.forEach(n=>{ %><p class="mb-2"><strong><%= n.title %></strong> &mdash; <%= n.message %> <small class="text-secondary"><%= n.created_at %></small></p><% }) %>
<% if(!notifications.length){ %><p class="text-secondary">No notifications.</p><% } %>
</section></div>
</div>
</main>
</body>
</html>
