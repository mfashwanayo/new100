<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <%= user.name %> &middot; Parent
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>
<main class="container py-4">
<p class="eyebrow">FAMILY SCHOOL PORTAL</p>
<h1 class="h3">Parent dashboard</h1>
<p class="text-secondary">Monitor your children's learning and school progress.</p>

<section class="panel mb-4"><h2 class="h5">My children</h2><div class="row g-3">
<% children.forEach(c=>{ %><div class="col-md-6"><div class="stat-card"><strong><%= c.full_name %></strong><div class="small text-secondary mt-1">Admission: <%= c.admission_number %> &middot; Class: <%= c.class_name||"Not assigned" %></div></div></div><% }) %>
<% if(!children.length){ %><div class="col-12 text-secondary">No child linked. Contact the school administrator.</div><% } %>
</div></section>

<div class="row g-4">
<div class="col-lg-6"><section class="panel"><h2 class="h5">Attendance</h2><div class="table-responsive"><table class="table"><thead><tr><th>Child</th><th>Date</th><th>Status</th></tr></thead><tbody>
<% attendance.forEach(a=>{ %><tr><td><%= a.full_name %></td><td><%= a.attendance_date %></td><td><span class="badge <%= a.status==='present'?'bg-success':a.status==='absent'?'bg-danger':a.status==='late'?'bg-warning text-dark':'bg-secondary' %>"><%= a.status %></span></td></tr><% }) %>
<% if(!attendance.length){ %><tr><td colspan="3">No attendance records.</td></tr><% } %>
</tbody></table></div></section></div>

<div class="col-lg-6"><section class="panel"><h2 class="h5">Published results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Child</th><th>Assessment</th><th>Marks</th></tr></thead><tbody>
<% results.forEach(x=>{ %><tr><td><%= x.full_name %></td><td><%= x.title %><small class="d-block text-secondary"><%= x.subject_name %></small></td><td><%= x.marks_obtained %>/<%= x.total_marks %></td></tr><% }) %>
<% if(!results.length){ %><tr><td colspan="3">No published results.</td></tr><% } %>
</tbody></table></div></section></div>

<div class="col-lg-6"><section class="panel"><h2 class="h5">School fees</h2>
<p class="text-secondary mb-0">Fee balances and payment history will be available in Stage 6 (Finance &amp; Payments).</p>
</section></div>

<div class="col-lg-6"><section class="panel"><h2 class="h5">Announcements</h2>
<% announcements.forEach(a=>{ %><article class="mb-3"><strong><%= a.title %></strong><p class="text-secondary mb-0"><%= a.body %></p></article><% }) %>
<% if(!announcements.length){ %><p class="text-secondary">No announcements.</p><% } %>
</section></div>

<div class="col-12"><section class="panel"><h2 class="h5">Notifications</h2>
<% notifications.forEach(n=>{ %><p><strong><%= n.title %></strong> &mdash; <%= n.message %></p><% }) %>
<% if(!notifications.length){ %><p class="text-secondary">No notifications.</p><% } %>
</section></div>
</div>
</main>
</body>
</html>
