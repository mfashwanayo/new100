<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
<style>
.chat-wrap{display:grid;grid-template-columns:280px 1fr;gap:0;background:var(--white);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;min-height:70vh}
.chat-list{border-right:1px solid var(--line);background:var(--line-soft);max-height:75vh;overflow-y:auto}
.chat-list a{display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--line);color:var(--ink);font-weight:600}
.chat-list a:hover{background:var(--blue-pale)}
.chat-list a.active{background:var(--blue-pale);border-left:4px solid var(--blue)}
.chat-main{display:flex;flex-direction:column;max-height:75vh}
.chat-head{padding:14px 18px;border-bottom:1px solid var(--line);font-weight:800;color:var(--navy);display:flex;align-items:center;gap:10px}
.chat-body{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:10px;background:#fafcff}
.bubble{max-width:72%;padding:10px 14px;border-radius:14px;font-size:.9rem;line-height:1.5;word-wrap:break-word}
.bubble.mine{align-self:flex-end;background:linear-gradient(135deg,var(--blue),var(--blue-light));color:#fff;border-bottom-right-radius:4px}
.bubble.theirs{align-self:flex-start;background:var(--white);border:1px solid var(--line);color:var(--ink);border-bottom-left-radius:4px}
.bubble small{display:block;font-size:.68rem;opacity:.7;margin-top:4px}
.chat-form{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--line);background:var(--white)}
.chat-form input{flex:1}
.empty-chat{flex:1;display:grid;place-items:center;color:var(--muted-light);text-align:center;padding:30px}
@media(max-width:767.98px){.chat-wrap{grid-template-columns:1fr}.chat-list{border-right:0;border-bottom:1px solid var(--line);max-height:200px}}
</style>
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white flex-wrap">
    <%= user.name %>
    <a href="/dashboard/<%= user.role %>" class="btn btn-sm btn-outline-light">Dashboard</a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container-fluid px-3 px-lg-4 py-4">
  <div class="page-header">
    <p class="eyebrow">COMMUNICATION</p>
    <h1>Messages</h1>
    <p>Chat with teachers, parents and school staff.</p>
  </div>

  <% if(notice){ %><div class="alert alert-info"><%= notice %></div><% } %>

  <div class="chat-wrap">
    <div class="chat-list">
      <% if(!contacts.length){ %>
        <div class="p-3 text-secondary small">No contacts available yet.</div>
      <% } %>
      <% contacts.forEach(c=>{ %>
        <a href="/dashboard/<%= user.role %>/chat?with=<%= c.id %>" class="<%= otherId===c.id?'active':'' %>">
          <span class="user-avatar" style="width:34px;height:34px;font-size:.85rem"><%= c.full_name[0] %></span>
          <span><span class="d-block"><%= c.full_name %></span><small class="text-secondary" style="text-transform:capitalize"><%= c.role.replace('_',' ') %></small></span>
        </a>
      <% }) %>
    </div>

    <div class="chat-main">
      <% if(!otherId){ %>
        <div class="empty-chat"><div><i class="bi bi-chat-dots" style="font-size:2.5rem;opacity:.4"></i><p class="mt-2 mb-0">Select a contact to start chatting.</p></div></div>
      <% } else { %>
        <div class="chat-head"><i class="bi bi-person-circle"></i> Conversation</div>
        <div class="chat-body" id="chatBody">
          <% if(!messages.length){ %>
            <div class="empty-chat"><p class="mb-0">No messages yet. Say hello!</p></div>
          <% } %>
          <% messages.forEach(m=>{ %>
            <div class="bubble <%= m.sender_id===user.id?'mine':'theirs' %>">
              <%= m.body %>
              <small><%= String(m.created_at).slice(11,16) %></small>
            </div>
          <% }) %>
        </div>
        <form class="chat-form" method="post" action="/dashboard/<%= user.role %>/chat">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="receiver_id" value="<%= otherId %>">
          <input class="form-control" name="body" placeholder="Type a message..." required autocomplete="off">
          <button class="btn btn-primary"><i class="bi bi-send"></i></button>
        </form>
      <% } %>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const b = document.getElementById('chatBody');
  if (b) b.scrollTop = b.scrollHeight;
</script>
</body>
</html>