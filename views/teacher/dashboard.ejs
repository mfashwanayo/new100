<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | UTUNYANGE</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/dashboards.css"></head><body>
<nav class="navbar navbar-dark app-nav px-3"><a class="navbar-brand fw-bold" href="/">UTUNYANGE</a><div class="text-white"><%= user.name %> &middot; Teacher <form class="d-inline" method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-light ms-2">Logout</button></form></div></nav>
<main class="container-fluid px-3 px-lg-4 py-4"><p class="eyebrow">TEACHING & LEARNING</p><h1 class="h3">Teacher dashboard</h1><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>
<div class="row g-3 my-2"><div class="col-md-4"><div class="stat-card"><div class="stat-label">Assigned class/subjects</div><div class="stat-number"><%= assignments.length %></div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Students</div><div class="stat-number"><%= students.length %></div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Attendance entries today</div><div class="stat-number"><%= todayAttendance %></div></div></div></div>
<div class="row g-4"><div class="col-xl-6"><section class="panel"><h2 class="h5">Teaching assignments</h2><table class="table"><thead><tr><th>Class</th><th>Subject</th><th>Year</th></tr></thead><tbody><% assignments.forEach(a=>{ %><tr><td><%= a.class_name %></td><td><%= a.subject_name %></td><td><%= a.academic_year||"â€”" %></td></tr><% }) %><% if(!assignments.length){ %><tr><td colspan="3">No assignments yet.</td></tr><% } %></tbody></table></section></div>
<div class="col-xl-6"><section class="panel"><h2 class="h5">Student register</h2><table class="table"><thead><tr><th>Student</th><th>Admission</th><th>Class</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><%= s.full_name %></td><td><%= s.admission_number %></td><td><%= s.class_name %></td></tr><% }) %><% if(!students.length){ %><tr><td colspan="3">No students assigned.</td></tr><% } %></tbody></table></section></div>
<div class="col-xl-6"><section class="panel"><h2 class="h5">Mark attendance</h2><form method="post" action="/dashboard/teacher/attendance" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-6"><label class="form-label">Class</label><select class="form-select" name="class_id" required><option value="">Choose</option><% [...new Map(assignments.map(a=>[a.class_id,a])).values()].forEach(a=>{ %><option value="<%= a.class_id %>"><%= a.class_name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Subject (optional)</label><select class="form-select" name="subject_id"><option value="">Class register</option><% assignments.forEach(a=>{ %><option value="<%= a.subject_id %>"><%= a.subject_name %> â€” <%= a.class_name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Student</label><select class="form-select" name="student_id" required><option value="">Choose</option><% students.forEach(s=>{ %><option value="<%= s.id %>"><%= s.full_name %> â€” <%= s.class_name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Date</label><input class="form-control" type="date" name="attendance_date" value="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="col-md-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option><option value="excused">Excused</option></select></div><div class="col-md-6"><label class="form-label">Notes</label><input class="form-control" name="notes" maxlength="255"></div><div class="col-12"><button class="btn btn-primary">Save attendance</button></div></form></section></div>
<div class="col-xl-6"><section class="panel"><h2 class="h5">Create assessment</h2><form method="post" action="/dashboard/teacher/assessments" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-12"><label class="form-label">Title</label><input class="form-control" name="title" required maxlength="160"></div><div class="col-md-6"><label class="form-label">Class & subject</label><select class="form-select" id="assn" required><option value="">Choose</option><% assignments.forEach(a=>{ %><option value="<%= a.class_id %>" data-sub="<%= a.subject_id %>"><%= a.class_name %> â€” <%= a.subject_name %></option><% }) %></select><input type="hidden" name="class_id" id="classId"><input type="hidden" name="subject_id" id="subjectId"></div><div class="col-md-6"><label class="form-label">Assessment date</label><input class="form-control" type="date" name="assessment_date"></div><div class="col-md-6"><label class="form-label">Total marks</label><input class="form-control" type="number" min="1" step=".01" name="total_marks" required></div><div class="col-12"><button class="btn btn-primary">Create assessment</button></div></form></section></div>
<div class="col-12"><section class="panel"><h2 class="h5">Assessments & marks</h2><div class="table-responsive"><table class="table"><thead><tr><th>Assessment</th><th>Class / subject</th><th>Total</th><th>Status</th><th>Enter mark</th><th>Publish</th></tr></thead><tbody><% assessments.forEach(a=>{ %><tr><td><%= a.title %></td><td><%= a.class_name %> / <%= a.subject_name %></td><td><%= a.total_marks %></td><td><%= a.is_published?"Published":"Draft" %></td><td><form method="post" action="/dashboard/teacher/marks" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="assessment_id" value="<%= a.id %>"><select class="form-select form-select-sm" name="student_id" required><option value="">Student</option><% students.filter(s=>s.class_id===a.class_id).forEach(s=>{ %><option value="<%= s.id %>"><%= s.full_name %></option><% }) %></select><input class="form-control form-control-sm" style="max-width:85px" type="number" min="0" max="<%= a.total_marks %>" step=".01" name="marks_obtained" required><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><% if(!a.is_published){ %><form method="post" action="/dashboard/teacher/publish-results"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="assessment_id" value="<%= a.id %>"><button class="btn btn-sm btn-success">Publish</button></form><% } %></td></tr><% }) %><% if(!assessments.length){ %><tr><td colspan="6">No assessments yet.</td></tr><% } %></tbody></table></div></section></div>
<div class="col-12"><section class="panel"><h2 class="h5">Recent attendance</h2><table class="table"><thead><tr><th>Date</th><th>Student</th><th>Class</th><th>Status</th></tr></thead><tbody><% attendance.forEach(a=>{ %><tr><td><%= a.attendance_date %></td><td><%= a.full_name %></td><td><%= a.class_name %></td><td><%= a.status %></td></tr><% }) %><% if(!attendance.length){ %><tr><td colspan="4">No attendance recorded.</td></tr><% } %></tbody></table></section></div></div></main>
<script>document.getElementById('assn').addEventListener('change',e=>{const o=e.target.selectedOptions[0];document.getElementById('classId').value=o?.value||'';document.getElementById('subjectId').value=o?.dataset.sub||'';});</script></body></html>
