<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <%= user.name %> &middot; Teacher
    <a href="/dashboard/teacher" class="btn btn-sm btn-outline-light">Dashboard</a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container py-4">
  <p class="eyebrow">LEARNING MANAGEMENT</p>
  <h1 class="h4">Submissions &mdash; <%= assignment.title %></h1>
  <% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>
  <a href="/dashboard/teacher/lms" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back to LMS</a>

  <section class="panel">
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th>Student</th><th>Submitted</th><th>Answer</th><th>Score</th><th>Feedback</th><th>Grade</th></tr></thead>
        <tbody>
          <% submissions.forEach(s=>{ %>
          <tr>
            <td><strong><%= s.full_name %></strong></td>
            <td><small><%= s.submitted_at %></small></td>
            <td><div style="max-width:280px;max-height:80px;overflow:auto"><%= s.answer_text || 'â€”' %></div></td>
            <td><%= s.score != null ? s.score : 'â€”' %></td>
            <td><%= s.feedback || 'â€”' %></td>
            <td>
              <% if(s.score == null){ %>
              <form method="post" action="/dashboard/teacher/lms/grade" class="d-flex gap-1">
                <input type="hidden" name="_csrf"         value="<%= csrfToken %>">
                <input type="hidden" name="submission_id" value="<%= s.id %>">
                <input class="form-control form-control-sm" style="max-width:70px" type="number" name="score" min="0" step=".01" required placeholder="Score">
                <input class="form-control form-control-sm" style="max-width:120px" name="feedback" placeholder="Feedback">
                <button class="btn btn-sm btn-primary">Grade</button>
              </form>
              <% } else { %>
              <span class="badge bg-success">Graded</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if(!submissions.length){ %>
          <tr><td colspan="6" class="text-secondary">No submissions yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
