<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<%
  const fmtRWF = n => 'RWF ' + Number(n||0).toLocaleString('en-US',{minimumFractionDigits:0});
  const statusClass = s => ({paid:'bg-success',partial:'bg-warning text-dark',unpaid:'bg-danger',cancelled:'bg-secondary'}[s]||'bg-secondary');
%>

<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <span class="nav-role-tag">Student</span>
    <%= user.name %>
    <a href="/dashboard/student" class="btn btn-sm btn-outline-light">Dashboard</a>
    <a href="/dashboard/student/lms" class="btn btn-sm btn-outline-light">LMS</a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container py-4">
  <div class="page-header">
    <p class="eyebrow">MY FINANCES</p>
    <h1>Fees &amp; Payments</h1>
  </div>
  <% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>

  <!-- SUMMARY CARDS -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="stat-card">
        <div class="stat-label">Total billed</div>
        <div class="stat-number"><%= fmtRWF(totalBilled) %></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card green">
        <div class="stat-label">Total paid</div>
        <div class="stat-number"><%= fmtRWF(totalPaid) %></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card <%= outstanding>0?'red':'green' %>">
        <div class="stat-label">Outstanding balance</div>
        <div class="stat-number"><%= fmtRWF(outstanding) %></div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- INVOICES -->
    <div class="col-lg-7">
      <section class="panel">
        <h2>My invoices</h2>
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Invoice</th><th>Fee</th><th>Billed</th><th>Paid</th><th>Balance</th><th>Due</th><th>Status</th></tr></thead>
            <tbody>
              <% invoices.forEach(i=>{ const bal=Number(i.amount_due)-Number(i.amount_paid); %>
              <tr>
                <td><code class="small"><%= i.invoice_number %></code><small class="d-block text-muted"><%= i.academic_year %> · <%= i.term %></small></td>
                <td><%= i.fee_name %></td>
                <td>RWF <%= Number(i.amount_due).toLocaleString() %></td>
                <td class="text-success fw-bold">RWF <%= Number(i.amount_paid).toLocaleString() %></td>
                <td class="<%= bal>0?'text-danger fw-bold':'' %>">RWF <%= bal.toLocaleString() %></td>
                <td><%= i.due_date %></td>
                <td><span class="badge <%= statusClass(i.status) %>"><%= i.status %></span></td>
              </tr>
              <% }) %>
              <% if(!invoices.length){ %>
              <tr><td colspan="7"><div class="empty-state"><p>No invoices yet. Contact the school administration.</p></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <!-- PAYMENT HISTORY -->
    <div class="col-lg-5">
      <section class="panel">
        <h2>Payment history</h2>
        <% if(!payments.length){ %>
        <div class="empty-state"><p>No payments recorded yet.</p></div>
        <% } %>
        <% payments.forEach(p=>{ %>
        <div class="notification-item">
          <div class="notification-dot" style="background:var(--green)"></div>
          <div>
            <p class="fw-bold mb-0">RWF <%= Number(p.amount).toLocaleString() %></p>
            <p class="mb-0"><%= p.invoice_number %> &middot; <%= p.payment_method.replace('_',' ') %></p>
            <% if(p.reference_number){ %><p class="mb-0 text-muted">Ref: <%= p.reference_number %></p><% } %>
            <small><%= p.paid_at %></small>
          </div>
        </div>
        <% }) %>
      </section>
    </div>

  </div>
</main>
</body>
</html>
