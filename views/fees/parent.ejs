<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | UTUNYANGE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/dashboards.css">
</head>
<body>
<%
  const fmtRWF = n => 'RWF ' + Number(n||0).toLocaleString('en-US',{minimumFractionDigits:0});
  const statusClass = s => ({paid:'bg-success',partial:'bg-warning text-dark',unpaid:'bg-danger',cancelled:'bg-secondary'}[s]||'bg-secondary');
%>

<nav class="navbar navbar-dark app-nav px-3">
  <a class="navbar-brand fw-bold" href="/">UTUNYANGE</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <span class="nav-role-tag">Parent</span>
    <%= user.name %>
    <a href="/dashboard/parent" class="btn btn-sm btn-outline-light">Dashboard</a>
    <form class="d-inline" method="post" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-light">Logout</button>
    </form>
  </div>
</nav>

<main class="container py-4">
  <div class="page-header">
    <p class="eyebrow">FAMILY FINANCES</p>
    <h1>School Fees</h1>
    <p>Fee invoices and payment status for your children.</p>
  </div>
  <% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %>

  <% if(!childrenFees.length){ %>
  <div class="alert alert-info">No children linked to your account. Contact the school administrator.</div>
  <% } %>

  <% childrenFees.forEach(child=>{ %>
  <section class="panel mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
      <div class="d-flex align-items-center gap-3">
        <div class="user-avatar"><%= child.full_name[0] %></div>
        <div>
          <h2 class="mb-0" style="font-size:1.1rem;border:none;padding:0"><%= child.full_name %></h2>
          <small class="text-muted">Admission: <%= child.admission_number %> &middot; Class: <%= child.class_name||'Not assigned' %></small>
        </div>
      </div>
      <div class="text-end">
        <div class="stat-label">Outstanding balance</div>
        <div class="h4 mb-0 <%= child.outstanding>0?'text-danger':'text-success' %>"><%= fmtRWF(child.outstanding) %></div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Invoice #</th><th>Fee</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Due</th><th>Status</th></tr></thead>
        <tbody>
          <% child.invoices.forEach(i=>{ const bal=Number(i.amount_due)-Number(i.amount_paid); %>
          <tr>
            <td><code class="small"><%= i.invoice_number %></code></td>
            <td><%= i.fee_name %></td>
            <td>RWF <%= Number(i.amount_due).toLocaleString() %></td>
            <td class="text-success fw-bold">RWF <%= Number(i.amount_paid).toLocaleString() %></td>
            <td class="<%= bal>0?'text-danger fw-bold':'' %>">RWF <%= bal.toLocaleString() %></td>
            <td><%= i.due_date %></td>
            <td><span class="badge <%= statusClass(i.status) %>"><%= i.status %></span></td>
          </tr>
          <% }) %>
          <% if(!child.invoices.length){ %>
          <tr><td colspan="7" class="text-center text-muted py-2">No invoices for this child.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
  <% }) %>
</main>
</body>
</html>
